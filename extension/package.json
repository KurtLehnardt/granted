{
  "name": "granted-assisted-fill",
  "version": "0.1.0",
  "private": true,
  "description": "Granted Assisted Fill — MV3 browser extension that fills a grant-portal form from a Granted-generated package in the user's own authenticated session. It never submits, signs, certifies, attests, or files. The human AOR reviews and submits.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.2.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
