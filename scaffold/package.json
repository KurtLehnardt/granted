{
  "name": "gov-opportunity-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import tsx --test \"lib/contracts/__tests__/*.test.ts\"",
    "data:fetch": "node scripts/1-fetch.mjs",
    "data:normalize": "node scripts/2-normalize.mjs",
    "data:embed": "node scripts/3-embed.mjs",
    "data:precompute": "node scripts/4-precompute.mjs",
    "data:competitors": "node --import tsx scripts/5-competitors.mjs",
    "data:demo": "node scripts/6-demo-fastercontrol.mjs",
    "data:all": "npm run data:fetch && npm run data:normalize && npm run data:embed",
    "data:fetch:sam": "node scripts/1-fetch-sam-assistance.mjs",
    "data:fetch:sbir-corpus": "node scripts/1-fetch-sbir-corpus.mjs",
    "data:fetch:procurement": "node scripts/1-fetch-procurement.mjs",
    "data:assemble": "node scripts/assemble-mvp-corpus.mjs",
    "data:mvp": "npm run data:fetch:sam && npm run data:fetch:sbir-corpus && npm run data:fetch:procurement && npm run data:assemble",
    "check:hex": "node scripts/design/check-hex.mjs",
    "check:contrast": "node scripts/design/contrast-check.mjs",
    "test": "tsx --test \"lib/**/__tests__/**/*.test.ts\" \"app/**/__tests__/**/*.test.ts\" \"scripts/**/__tests__/**/*.test.ts\" \"components/**/__tests__/**/*.test.ts\"",
    "e2e": "playwright test",
    "check:prompts": "node scripts/check-prompt-registry.mjs",
    "canon:seed": "node --import tsx scripts/canon/seed-from-v1.mjs",
    "canon:ingest": "node --import tsx scripts/canon/ingest-grants.mjs",
    "canon:extract-rules": "node --import tsx scripts/canon/extract-rules.mjs",
    "cost:measure": "node --import tsx scripts/cost-measure.mjs",
    "eval:precomputed": "node --import tsx scripts/eval-precomputed.mjs",
    "eval:quality": "node --import tsx scripts/eval-run.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "14.2.15",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.26.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3"
  }
}
