# Copy to .env.local for local dev (or just run `npm run setup`). Granted runs
# locally; there is no hosted deployment. Every key is optional.
#
# Search needs no key: it runs on a built-in model on this computer
# (nomic-embed-text-v1.5, downloaded once into scaffold/models/ by the installer,
# `npm run model:fetch`, or the first search). Scoring the matches needs ONE
# provider: ANTHROPIC_API_KEY (Claude) or OPENAI_API_KEY (gpt-4o-mini), another
# provider picked in Settings → Model (Gemini, Groq, OpenRouter, Mistral, an
# Anthropic-compatible proxy...), or a LOCAL model (the block near the bottom).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Which embeddings search uses: auto (default), builtin, or openai.
#   auto     OpenAI's embeddings when a valid OPENAI_API_KEY is set (as before),
#            otherwise the built-in model. Always built-in on a Local model.
#   builtin  the built-in model, even with an OpenAI key (no per-search cost, offline).
#   openai   OpenAI's text-embedding-3-small (needs OPENAI_API_KEY).
# SEARCH_EMBEDDINGS=auto
# Download the built-in model from a mirror holding the same files (default:
# the pinned Hugging Face revision). Files are checked against pinned SHA-256s.
# Use this behind a proxy or firewall: the download uses Node's fetch, which ignores HTTPS_PROXY.
# GRANTED_MODEL_URL=https://mirror.example.org/nomic-embed-text-v1.5

# R5-deep (competitor & grant intelligence) — the live /api/competitors market brief.
# EXA_API_KEY is OPTIONAL: when set, the live route also web-searches private
# competitor profiles (exa). When ABSENT, the route degrades honestly to federal
# awardees only (keyless USAspending/NIH/NSF) with a visible note — it never fails.
EXA_API_KEY=
# The live personalized brief — the deep competitor & market analysis. ON by
# default so competitor analysis works out of the box (federal awardees are
# keyless via USAspending/NIH/NSF; add EXA_API_KEY above for web competitors).
# Set to "false" to disable. It's free to use; the "Max/Pro" tier framing only
# appears when the separate `commercial_ui` flag (NEXT_PUBLIC_FLAG_COMMERCIAL_UI,
# default off) is on.
NEXT_PUBLIC_FLAG_R5_DEEP_ANALYSIS=true

# The matching "discernment" layer — the advisory recommend / verify /
# do-not-recommend verdict + whole-map verdict + rubric-anchored scoring.
# Default OFF. "true" turns on the honest "don't apply" surface. (See README.)
NEXT_PUBLIC_FLAG_DISCERNMENT_LAYER=false

# R9.0 (CON-03 flag: r9_0_mockauth) — client-side-only mocked Google sign-in backed by
# localStorage. NOT authentication; gates nothing server-side. Defaults off/false so it
# can never silently reach production. Set to "true" in .env.local to demo the
# /login -> / -> log out loop. Removed entirely (flag included) when real OAuth lands at R9.
NEXT_PUBLIC_MOCK_AUTH=false

# ─────────────────────────────────────────────────────────────────────────────
# Run on a LOCAL model (no API keys, nothing leaves your machine)
# ─────────────────────────────────────────────────────────────────────────────
# Point the reasoning/scoring at any OpenAI-compatible endpoint. With Ollama:
#   1) install Ollama, then `ollama pull gemma4` (or qwen2.5, llama3.1, …)
#   2) set the two vars below. ANTHROPIC_API_KEY is then NOT needed.
# NOTE: keep comments on their OWN lines — a trailing "# ..." after a value becomes
# part of the value when you uncomment it (e.g. an invalid model name).
# LLM_PROVIDER=ollama
# LOCAL_LLM_MODEL=gemma4:latest
# LLM_BASE_URL default. Ollama/LM Studio/vLLM serve the OpenAI-compatible API under
# /v1 — a bare host (no /v1) is auto-corrected, but prefer including it:
# LLM_BASE_URL=http://localhost:11434/v1
#
# Search already runs locally (the built-in model above), so with a local model
# nothing leaves your machine and nothing needs re-embedding. Its vectors are the
# same as Ollama's nomic-embed-text, so the shipped corpus serves both.
#
# Advanced: your own embedding server instead of the built-in model. Point these
# at it, then re-embed the corpus with it (`npm run data:embed:local` reads
# .env.local). A setup made by an older `npm run setup:local` looks like this and
# keeps working; remove both lines to switch it to the built-in model.
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_MODEL=nomic-embed-text
# LLM_CANDIDATE_COUNT (optional, default 24): lowers the global similarity cut; per-type
# quotas may still keep more candidates, so it's a soft speed knob, not a hard cap.
# LLM_CANDIDATE_COUNT=12
