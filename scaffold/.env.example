# Copy to .env.local for local dev (or just run `npm run setup`). Add the same
# vars to your Vercel project settings for deploy. Only the two keys below are
# REQUIRED to run the core app with hosted models — OR skip them entirely and
# run on a LOCAL model (see the "Run on a local model" block near the bottom).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# R5-deep (competitor & grant intelligence) — the live /api/competitors market brief.
# EXA_API_KEY is OPTIONAL: when set, the live route also web-searches private
# competitor profiles (exa). When ABSENT, the route degrades honestly to federal
# awardees only (keyless USAspending/NIH/NSF) with a visible note — it never fails.
EXA_API_KEY=
# Default-OFF flag gating the live personalized brief (Max tier). "true" to enable.
NEXT_PUBLIC_FLAG_R5_DEEP_ANALYSIS=false

# The matching "discernment" layer — the advisory recommend / verify /
# do-not-recommend verdict + whole-map verdict + rubric-anchored scoring.
# Default OFF. "true" turns on the honest "don't apply" surface. (See README.)
NEXT_PUBLIC_FLAG_DISCERNMENT_LAYER=false

# R9.0 (CON-03 flag: r9_0_mockauth) — client-side-only mocked Google sign-in backed by
# localStorage. NOT authentication; gates nothing server-side. Defaults off/false so it
# can never silently reach production. Set to "true" in .env.local to demo the
# /login -> / -> log out loop. Removed entirely (flag included) when real OAuth lands at R9.
NEXT_PUBLIC_MOCK_AUTH=false

# R9 real auth (CON-03 flag: r9_supabase_auth) — drop-in Supabase Auth + Google OAuth that
# replaces the R9.0 mock. Wins over NEXT_PUBLIC_MOCK_AUTH when both are on. Defaults false.
NEXT_PUBLIC_FLAG_R9_SUPABASE_AUTH=false

# Supabase project URL — public, safe to commit. Paste YOUR project's URL
# (Supabase Dashboard -> Project Settings -> API). Only needed for real sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase ANON / PUBLISHABLE key — paste YOUR anon (publishable) key from
# Supabase Dashboard -> Project Settings -> API into .env.local. Left BLANK here.
# NEVER put the secret/service_role key here: it must never reach the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Run on a LOCAL model (no API keys, nothing leaves your machine)
# ─────────────────────────────────────────────────────────────────────────────
# Point the reasoning/scoring at any OpenAI-compatible endpoint. With Ollama:
#   1) install Ollama, then `ollama pull gemma4` (or qwen2.5, llama3.1, …)
#   2) set the two vars below. ANTHROPIC_API_KEY is then NOT needed.
# LLM_PROVIDER=ollama
# LOCAL_LLM_MODEL=gemma4:latest
# LLM_BASE_URL=http://localhost:11434/v1     # default; any OpenAI-compatible URL works
#
# To go FULLY offline, also run embeddings locally, then RE-EMBED the corpus
# (`npm run data:embed`) so query + corpus share one embedding space:
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1
# EMBEDDINGS_MODEL=nomic-embed-text          # `ollama pull nomic-embed-text` first
# LLM_CANDIDATE_COUNT=12                      # optional: fewer candidates scored = faster local runs (default 24)

# ─────────────────────────────────────────────────────────────────────────────
# Deployment (optional) — only if you host this somewhere
# ─────────────────────────────────────────────────────────────────────────────
# Your deployment's public URL, used for canonical/share metadata on the /welcome
# landing page. Defaults to http://localhost:3000 for local dev.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com

# ─────────────────────────────────────────────────────────────────────────────
# Canon corpus store (ADVANCED / optional) — NOT needed to run the app
# ─────────────────────────────────────────────────────────────────────────────
# The app ships a prebuilt corpus in data/, so you do NOT need a database. These
# are only for the optional corpus-ingestion/rule-extraction pipeline
# (scripts/canon/*). Point them at YOUR OWN Postgres/Supabase project.
# FUNDFINDER_DB_PROJECT_REF=your-project-ref
# FUNDFINDER_DB_PASSWORD=your-db-password
# FUNDFINDER_DB_HOST=aws-0-us-west-2.pooler.supabase.com   # your pooler host
# FUNDFINDER_DB_PORT=6543
# FUNDFINDER_DB_NAME=postgres
